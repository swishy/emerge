# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
emerge_skia-*.tar

# Rust build artifacts
/native/*/target/

# Clang module cache artifacts (__.SYMDEF)
/native/*/__.SYMDEF
**/__.SYMDEF

# Compiled NIF
/priv/native/

# Vendored Rust dependencies (e.g. patched rustler)
/native/*/vendor/

# Scratch planning docs
/plans/

# Local Codex session files
/.codex

# macOS
.DS_Store

# Editor swap files
*.swp
*.swo

# Language server artifacts
/.elixir_ls/

# iOS generated assets (Xcode project, frameworks, bundled OTP)
/ios/Frameworks/
/ios/Emerge/erlang/
/ios/**/xcuserdata/

# IDE
/.idea/
*.iml
